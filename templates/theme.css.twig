/* Symfony's black and white identity: https://symfony.com/logo */
.light-mode {
    --scalar-color-1: #000000;
    --scalar-color-2: #525252;
    --scalar-color-3: #666666;
    --scalar-color-accent: #000000;
    --scalar-background-1: #ffffff;
    --scalar-background-2: #f5f5f5;
    --scalar-background-3: #ebebeb;
    --scalar-background-accent: #ebebeb;
    --scalar-border-color: #dedede;
    --scalar-button-1: #000000;
    --scalar-button-1-color: #ffffff;
    --scalar-button-1-hover: #262626;
    --scalar-scrollbar-color: #dedede;
    --scalar-scrollbar-color-active: #666666;
    --scalar-sidebar-background-1: #f5f5f5;
    --scalar-sidebar-color-1: #000000;
    --scalar-sidebar-color-2: #525252;
    --scalar-sidebar-color-active: #ffffff;
    --scalar-sidebar-item-active-background: #000000;
    --scalar-sidebar-item-hover-background: #ebebeb;
    --scalar-sidebar-item-hover-color: #000000;
    --scalar-sidebar-border-color: #dedede;
    --scalar-sidebar-search-background: #ffffff;
    --scalar-sidebar-search-border-color: #dedede;
    --scalar-sidebar-search-color: #666666;
}

.dark-mode {
    --scalar-color-1: #ffffff;
    --scalar-color-2: #d4d4d4;
    --scalar-color-3: #a3a3a3;
    --scalar-color-accent: #ffffff;
    --scalar-background-1: #000000;
    --scalar-background-2: #171717;
    --scalar-background-3: #262626;
    --scalar-background-accent: #262626;
    --scalar-border-color: #333333;
    --scalar-button-1: #ffffff;
    --scalar-button-1-color: #000000;
    --scalar-button-1-hover: #ebebeb;
    --scalar-scrollbar-color: #333333;
    --scalar-scrollbar-color-active: #a3a3a3;
    --scalar-sidebar-background-1: #171717;
    --scalar-sidebar-color-1: #ffffff;
    --scalar-sidebar-color-2: #d4d4d4;
    --scalar-sidebar-color-active: #000000;
    --scalar-sidebar-item-active-background: #ffffff;
    --scalar-sidebar-item-hover-background: #262626;
    --scalar-sidebar-item-hover-color: #ffffff;
    --scalar-sidebar-border-color: #333333;
    --scalar-sidebar-search-background: #000000;
    --scalar-sidebar-search-border-color: #333333;
    --scalar-sidebar-search-color: #a3a3a3;
}
